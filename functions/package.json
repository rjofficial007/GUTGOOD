{
  "name": "gutgood-functions",
  "description": "GutGood secure backend: AI proxy, anonymous account merge, lifecycle cleanup.",
  "version": "1.0.0",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
