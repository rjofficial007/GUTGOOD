  },
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.1",
    "nodemailer": "^6.9.13",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.14"
  },
  "private": true
}
