rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Checks if the requester is the owner of the user profile
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: validates the client-written premium fields.
    // Premium is managed CLIENT-SIDE via the RevenueCat SDK entitlement check;
    // the app mirrors that entitlement into the profile so it is available
    // cross-device and to the aiProxy quota check. Shape is validated here so
    // garbage values can't be stored even from a tampered client.
    function isValidPremiumFields() {
      let premium = request.resource.data.get('isPremium', false);
      let status = request.resource.data.get('subscriptionStatus', 'free');
      return premium is bool
        && status is string
        && status in ['free', 'premium']
        // Consistency: a paid flag must not carry the 'free' status.
        && (premium == false || status == 'premium');
    }

    // Validation for UserProfile specific fields.
    function isValidUserProfile() {
      let data = request.resource.data;
      return isValidPremiumFields()
        && data.get('onboarded', false) is bool
        && data.get('gutScore', 0) is number
        && data.get('gutScore', 0) >= 0
        && data.get('gutScore', 0) <= 100;
    }

    // Shape validation for chat messages written by clients (audit §3.3 —
    // prevents oversized/garbage documents and cost blowups).
    function isValidChatMessage() {
      return request.resource.data.role in ['user', 'ai']
        && request.resource.data.text is string
        && request.resource.data.text.size() < 20000
        && request.resource.data.get('imageUrls', []) is list
        && request.resource.data.get('imageUrls', []).size() <= 4
        && request.resource.size() < 512 * 1024;
    }

    match /user_profiles/{userId} {
      allow read: if isOwner(userId);

      // User profile validation: includes premium fields, onboarding status,
      // and gut score constraints. Size restricted to 256KB for rich profile data.
      allow create: if isOwner(userId)
        && isValidUserProfile()
        && request.resource.size() < 256 * 1024;

      allow update: if isOwner(userId)
        && isValidUserProfile()
        && (request.resource.data.get('streak', 0) == resource.data.get('streak', 0))
        && (request.resource.data.get('gutScore', 0) == resource.data.get('gutScore', 0))
        && (request.resource.data.get('lastActivityDate', '') == resource.data.get('lastActivityDate', ''))
        && request.resource.size() < 256 * 1024;

      allow delete: if isOwner(userId);

      match /chat_history/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChatMessage();
        allow update: if isOwner(userId) && isValidChatMessage();
        allow delete: if isOwner(userId);
      }

      match /scan_history/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && request.resource.size() < 512 * 1024;
        allow delete: if isOwner(userId);
      }

      match /meal_logs/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && request.resource.size() < 256 * 1024;
        allow delete: if isOwner(userId);
      }

      match /symptom_logs/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && request.resource.size() < 256 * 1024;
        allow delete: if isOwner(userId);
      }

      match /insights/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && request.resource.size() < 512 * 1024;
        allow delete: if isOwner(userId);
      }

      // Usage counters are server-authoritative now: the aiProxy Cloud
      // Function (Admin SDK) consumes them transactionally. Clients may only
      // READ their own usage for the paywall fast-path — never write it.
      // (Closes the "reset your own counters" bypass from audit §3.1.)
      match /daily_usage/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /pattern_data/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && request.resource.size() < 512 * 1024;
      }

      match /health_alerts/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && request.resource.size() < 256 * 1024;
        allow delete: if isOwner(userId);
      }

      // Idempotency markers written only by the mergeAnonymousAccount Cloud
      // Function (Admin SDK bypasses rules). Clients can read but never forge.
      match /merges/{anonUid} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Explicit default-deny for anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
